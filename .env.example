NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/ibs_intelligence_news
# Set true only when the PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Azure App Service can use these separate settings instead of DATABASE_URL.
# Keep DATABASE_URL empty when using them; store PGPASSWORD in Key Vault.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=disable
FIREBASE_PROJECT_ID=
# Firebase Hosting domain used by email authentication action links.
FIREBASE_AUTH_DOMAIN=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and use escaped newlines when stored on one line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Preferred on a server: path to a Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Store identifiers and verification credentials. Product IDs are stored in
# the subscription_plans database table rather than in this file.
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Keep the quotes and use escaped newlines when stored on one line.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APPLE_APP_APPLE_ID=
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTS_DIR=C:\ibsi-pdfs\apple-root-certs
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes and use escaped newlines when stored on one line.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Optional until enhanced push security is enabled in the EAS dashboard.
# Store the real value in Azure Key Vault, never GitHub.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_BATCH_INTERVAL_MS=250
EXPO_RECEIPT_DELAY_SECONDS=900
APP_BASE_URL=http://localhost:3000
# Must match the `scheme` configured in the Expo/React Native app.
MOBILE_APP_SCHEME=ibsintelligence
# Comma-separated origins. Leave blank during local mobile development.
CORS_ORIGINS=
LOG_LEVEL=info
# WordPress source for podcast and video listings.
WORDPRESS_BASE_URL=https://ibsintelligence.com
# Cloudflare returns an empty 403 to non-browser clients, so outbound requests
# must present a browser user agent until this server's IP is allowlisted.
WORDPRESS_USER_AGENT=
# Cloudflare blocks Node's TLS fingerprint even with a browser user agent. Ask
# whoever manages Cloudflare for a WAF "Skip" rule matching a secret header,
# then set both values here. Leave blank once the server IP is allowlisted.
WORDPRESS_BYPASS_HEADER=
WORDPRESS_BYPASS_VALUE=
WORDPRESS_TIMEOUT_MS=15000
# How long podcast and video listings are held in memory, in seconds.
MEDIA_CACHE_TTL_SECONDS=900
# Private journal PDFs. Use a different random secret in every environment.
JOURNAL_STORAGE_DIR=C:\ibsi-pdfs\ibs-journal
JOURNAL_IMAGE_BASE_URL=https://galaxy.ibsintelligence.com/vision-solution-images/img/journal-img/
JOURNAL_SIGNING_SECRET=replace_with_at_least_32_random_characters
# Signed viewing links remain reusable for one hour.
JOURNAL_URL_TTL_SECONDS=3600
# Private white paper PDFs. One flat directory holds every paper regardless of
# category. Use a secret of its own so rotating it does not invalidate
# outstanding journal links.
WHITEPAPER_STORAGE_DIR=C:\ibsi-pdfs\ibs-whitepaper
WHITEPAPER_IMAGE_BASE_URL=https://galaxy.ibsintelligence.com/vision-solution-images/img/whitepaper-img/
WHITEPAPER_SIGNING_SECRET=replace_with_at_least_32_random_characters
WHITEPAPER_URL_TTL_SECONDS=3600
